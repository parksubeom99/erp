# --- Database ---------------------------------------------------------------
# Migration/admin connection (role that owns the schema; runs prisma migrate).
DATABASE_URL="postgresql://edim:edim@localhost:5433/edim?schema=public"
# Runtime app connection. Uses a NON-superuser role so RLS is actually enforced
# (superusers and BYPASSRLS roles ignore row-level security). Created in STEP 1.
APP_DATABASE_URL="postgresql://edim_app:edim_app@localhost:5433/edim?schema=public"

# --- Auth (STEP 2) ----------------------------------------------------------
# Secret used to sign the session cookie. Generate: openssl rand -base64 32
AUTH_SECRET="dev-only-change-me-please-0000000000000000000="
