{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "declaration": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@edim/core-ontology": ["packages/core-ontology/src/index.ts"],
      "@edim/db": ["packages/db/src/index.ts"],
      "@edim/auth": ["packages/auth/src/index.ts"],
      "@edim/ui": ["packages/ui/src/index.ts"]
    }
  }
}
