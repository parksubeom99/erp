{
  "name": "@edim/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "dotenv -e ../../.env -- prisma generate",
    "lint": "tsc --noEmit",
    "generate": "dotenv -e ../../.env -- prisma generate",
    "migrate": "dotenv -e ../../.env -- prisma migrate deploy",
    "migrate:dev": "dotenv -e ../../.env -- prisma migrate dev",
    "seed": "dotenv -e ../../.env -- tsx prisma/seed.ts",
    "rls:test": "dotenv -e ../../.env -- tsx prisma/rls-isolation-test.ts",
    "hierarchy:test": "dotenv -e ../../.env -- tsx prisma/hierarchy-test.ts",
    "macro:test": "dotenv -e ../../.env -- tsx prisma/macro-registry-test.ts"
  },
  "dependencies": {
    "@edim/core-ontology": "workspace:*",
    "@prisma/client": "^6.2.1"
  },
  "devDependencies": {
    "dotenv-cli": "^8.0.0",
    "prisma": "^6.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "@types/node": "^22.10.5"
  }
}
