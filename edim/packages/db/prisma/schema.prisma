// EDIM L1 data model. See handoff §4.
//
// Principles baked in here:
//  - stable_id / revision_id separation on hierarchy_node (identity vs version).
//  - tenant_id on every tenant-scoped table (RLS scope column).
// RLS policies and the non-superuser app role are NOT expressible in Prisma
// schema — they live in the hand-written migration 0002_rls. This schema is the
// source of truth for the generated client and the table shapes; the DDL in
// migration 0001_init is kept in lockstep with it by hand.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug      String   @unique
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  memberships    Membership[]
  hierarchyNodes HierarchyNode[]
  auditLogs      AuditLog[]
  projects       Project[]
  attachments    ProjectAttachment[]
  tasks          ProjectTask[]
  approvals      ProjectApproval[]

  @@map("tenant")
}

model AppUser {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email     String   @unique
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  memberships        Membership[]
  createdNodes       HierarchyNode[]
  auditActions       AuditLog[]
  createdProjects    Project[]
  uploadedFiles      ProjectAttachment[]
  approvalsRequested ProjectApproval[]   @relation("ApprovalRequester")
  approvalsToDecide  ProjectApproval[]   @relation("ApprovalApprover")

  @@map("app_user")
}

model Membership {
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([tenantId, userId])
  @@map("membership")
}

model HierarchyNode {
  stableId     String   @default(dbgenerated("gen_random_uuid()")) @map("stable_id") @db.Uuid
  revisionId   String   @default(dbgenerated("gen_random_uuid()")) @map("revision_id") @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  parentStable String?  @map("parent_stable") @db.Uuid
  kind         String
  label        String
  position     Int
  isCurrent    Boolean  @default(true) @map("is_current")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy    String   @map("created_by") @db.Uuid

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  creator AppUser @relation(fields: [createdBy], references: [id])

  @@id([stableId, revisionId])
  @@index([tenantId, parentStable, position])
  @@map("hierarchy_node")
}

model AuditLog {
  id       BigInt   @id @default(autoincrement())
  tenantId String   @map("tenant_id") @db.Uuid
  actorId  String   @map("actor_id") @db.Uuid
  action   String
  entity   String
  entityId String   @map("entity_id")
  before   Json?    @db.JsonB
  after    Json?    @db.JsonB
  at       DateTime @default(now()) @db.Timestamptz(6)

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actor  AppUser @relation(fields: [actorId], references: [id])

  @@map("audit_log")
}

// --- L3 Phase A: Project Management (handoff §3.1) --------------------------
// Project is the detail table for a Hierarchy node of kind='project'
// (Hierarchy = address, table = detail). `hierarchyStable` points at the node's
// stable_id; it is NOT a code column — project_no is a human-readable number,
// not an RCCS code (GAP1 stays untouched).

model Project {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  hierarchyStable String   @map("hierarchy_stable") @db.Uuid
  projectNo       String   @map("project_no")
  name            String
  type            String // 'client' | 'internal'
  clientName      String?  @map("client_name")
  clientContact   String?  @map("client_contact")
  itemType        String?  @map("item_type") // free text (e.g. 'AHU'), not a code
  salesStage      String   @map("sales_stage") // 기술제안|견적|협의|계약|계약변경|종료
  status          String // 'active' | 'closed'
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy       String   @map("created_by") @db.Uuid

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  creator     AppUser             @relation(fields: [createdBy], references: [id])
  attachments ProjectAttachment[]
  tasks       ProjectTask[]
  approvals   ProjectApproval[]

  @@unique([tenantId, projectNo])
  @@index([tenantId, hierarchyStable])
  @@map("project")
}

model ProjectAttachment {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  projectId   String   @map("project_id") @db.Uuid
  department  String
  docType     String   @map("doc_type")
  name        String
  description String?
  fileRef     String   @map("file_ref") // storage path/key; binary upload out of scope
  uploadedAt  DateTime @default(now()) @map("uploaded_at") @db.Timestamptz(6)
  uploadedBy  String   @map("uploaded_by") @db.Uuid

  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploader AppUser @relation(fields: [uploadedBy], references: [id])

  @@index([tenantId, projectId])
  @@map("project_attachment")
}

model ProjectTask {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  projectId String    @map("project_id") @db.Uuid
  title     String
  state     String // 'todo' | 'done'
  dueAt     DateTime? @map("due_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([tenantId, projectId])
  @@map("project_task")
}

model ProjectApproval {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  projectId   String    @map("project_id") @db.Uuid
  requesterId String    @map("requester_id") @db.Uuid
  approverId  String?   @map("approver_id") @db.Uuid
  state       String // 'requested' | 'approved' | 'rejected'
  note        String?
  requestedAt DateTime  @default(now()) @map("requested_at") @db.Timestamptz(6)
  decidedAt   DateTime? @map("decided_at") @db.Timestamptz(6)

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requester AppUser  @relation("ApprovalRequester", fields: [requesterId], references: [id])
  approver  AppUser? @relation("ApprovalApprover", fields: [approverId], references: [id])

  @@index([tenantId, projectId])
  @@map("project_approval")
}
