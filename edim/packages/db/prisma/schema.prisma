// EDIM L1 data model. See handoff §4.
//
// Principles baked in here:
//  - stable_id / revision_id separation on hierarchy_node (identity vs version).
//  - tenant_id on every tenant-scoped table (RLS scope column).
// RLS policies and the non-superuser app role are NOT expressible in Prisma
// schema — they live in the hand-written migration 0002_rls. This schema is the
// source of truth for the generated client and the table shapes; the DDL in
// migration 0001_init is kept in lockstep with it by hand.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug      String   @unique
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  memberships    Membership[]
  hierarchyNodes HierarchyNode[]
  auditLogs      AuditLog[]

  @@map("tenant")
}

model AppUser {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email     String   @unique
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  memberships  Membership[]
  createdNodes HierarchyNode[]
  auditActions AuditLog[]

  @@map("app_user")
}

model Membership {
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([tenantId, userId])
  @@map("membership")
}

model HierarchyNode {
  stableId     String   @default(dbgenerated("gen_random_uuid()")) @map("stable_id") @db.Uuid
  revisionId   String   @default(dbgenerated("gen_random_uuid()")) @map("revision_id") @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  parentStable String?  @map("parent_stable") @db.Uuid
  kind         String
  label        String
  position     Int
  isCurrent    Boolean  @default(true) @map("is_current")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy    String   @map("created_by") @db.Uuid

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  creator AppUser @relation(fields: [createdBy], references: [id])

  @@id([stableId, revisionId])
  @@index([tenantId, parentStable, position])
  @@map("hierarchy_node")
}

model AuditLog {
  id       BigInt   @id @default(autoincrement())
  tenantId String   @map("tenant_id") @db.Uuid
  actorId  String   @map("actor_id") @db.Uuid
  action   String
  entity   String
  entityId String   @map("entity_id")
  before   Json?    @db.JsonB
  after    Json?    @db.JsonB
  at       DateTime @default(now()) @db.Timestamptz(6)

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actor  AppUser @relation(fields: [actorId], references: [id])

  @@map("audit_log")
}
